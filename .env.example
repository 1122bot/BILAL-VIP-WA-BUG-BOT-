# Panel / backend environment variables
# Pterodactyl: Startup tab | VPS: .env file

HOST=0.0.0.0
PORT=3000

# MongoDB (sessions ko restart-proof banata hai)
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/bilalvip?retryWrites=true&w=majority
MONGODB_DB=bilalvip
SESSION_BACKUP_INTERVAL_MS=45000

# Vercel proxy <-> panel shared secret (config.json ke api_secret se same)
API_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Admin panel password (minimum 32 characters)
ADMIN_PASSWORD=CHANGE_ME_TO_A_32_PLUS_CHARACTER_PASSWORD

# Session limits
MAX_SESSIONS=10

# Optional CORS allow-list (comma separated)
CORS_ORIGIN=https://your-project.vercel.app

# Community links (optional)
TELEGRAM_CHANNEL_URL=https://t.me/bilal_king_vip
TELEGRAM_USERNAME=bilal_babar_982
WHATSAPP_CHANNEL_URL=
WHATSAPP_GROUP_URL=
OWNER_CONTACT_URL=https://wa.me/923078071982
